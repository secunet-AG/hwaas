# Upstream-Project: <https://editorconfig.org/>
# Configured-For-Version: 0.17.2

# Ignore other `.editorconfig` further up the file tree
root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
max_line_length = 100

[{*.yml,*.yaml}]
indent_size = 2

[{*.nix}]
indent_size = 2

[COMMIT_EDITMSG]
max_line_length = 72
