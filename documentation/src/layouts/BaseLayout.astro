  api: '<svg width="15" height="15" viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M9.03606 2.31408C9.13865 2.05778 9.42913 1.93325 9.68548 2.03576C9.94183 2.1383 10.0663 2.42881 9.9638 2.68517L5.9638 12.6852C5.86124 12.9416 5.57077 13.066 5.31438 12.9635C5.05802 12.8609 4.93351 12.5705 5.03606 12.3141L9.03606 2.31408ZM11.1464 5.14611C11.3173 4.97532 11.5813 4.95355 11.7753 5.08166L11.8534 5.14611L13.8534 7.14611L13.9179 7.22423C14.046 7.41829 14.0242 7.68227 13.8534 7.85314L11.8534 9.85314C11.6582 10.0484 11.3417 10.0484 11.1464 9.85314C10.9512 9.65787 10.9512 9.34135 11.1464 9.14611L12.7929 7.49962L11.1464 5.85314L11.082 5.77501C10.9539 5.58094 10.9756 5.31695 11.1464 5.14611ZM3.14641 5.14611C3.34166 4.95094 3.6582 4.95094 3.85344 5.14611C4.04868 5.34135 4.04864 5.65787 3.85344 5.85314L2.20696 7.49962L3.85344 9.14611L3.9179 9.22423C4.04605 9.41829 4.02425 9.68227 3.85344 9.85314C3.68258 10.024 3.41862 10.0458 3.22454 9.91759L3.14641 9.85314L1.14641 7.85314C0.951218 7.65787 0.951173 7.34135 1.14641 7.14611L3.14641 5.14611Z" fill="currentColor"/></svg>',
  rocket: '<svg width="15" height="15" viewBox="0 0 15 15" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M6.85357 3.85355L7.65355 3.05353C8.2981 2.40901 9.42858 1.96172 10.552 1.80125C11.1056 1.72217 11.6291 1.71725 12.0564 1.78124C12.4987 1.84748 12.7698 1.97696 12.8965 2.10357C13.0231 2.23018 13.1526 2.50125 13.2188 2.94357C13.2828 3.37086 13.2779 3.89439 13.1988 4.44801C13.0383 5.57139 12.591 6.70188 11.9464 7.34645L7.49999 11.7929L6.35354 10.6465C6.15827 10.4512 5.84169 10.4512 5.64643 10.6465C5.45117 10.8417 5.45117 11.1583 5.64643 11.3536L7.14644 12.8536C7.34171 13.0488 7.65829 13.0488 7.85355 12.8536L8.40073 12.3064L9.57124 14.2572C9.65046 14.3893 9.78608 14.4774 9.9389 14.4963C10.0917 14.5151 10.2447 14.4624 10.3535 14.3536L12.3535 12.3536C12.4648 12.2423 12.5172 12.0851 12.495 11.9293L12.0303 8.67679L12.6536 8.05355C13.509 7.19808 14.0117 5.82855 14.1887 4.58943C14.2784 3.9618 14.2891 3.33847 14.2078 2.79546C14.1287 2.26748 13.9519 1.74482 13.6035 1.39645C13.2552 1.04809 12.7325 0.871332 12.2045 0.792264C11.6615 0.710945 11.0382 0.721644 10.4105 0.8113C9.17143 0.988306 7.80189 1.491 6.94644 2.34642L6.32322 2.96968L3.07071 2.50504C2.91492 2.48278 2.75773 2.53517 2.64645 2.64646L0.646451 4.64645C0.537579 4.75533 0.484938 4.90829 0.50375 5.0611C0.522563 5.21391 0.61073 5.34954 0.742757 5.42876L2.69364 6.59928L2.14646 7.14645C2.0527 7.24022 2.00002 7.3674 2.00002 7.50001C2.00002 7.63261 2.0527 7.75979 2.14646 7.85356L3.64647 9.35356C3.84173 9.54883 4.15831 9.54883 4.35357 9.35356C4.54884 9.1583 4.54884 8.84172 4.35357 8.64646L3.20712 7.50001L3.85357 6.85356L6.85357 3.85355ZM10.0993 13.1936L9.12959 11.5775L11.1464 9.56067L11.4697 11.8232L10.0993 13.1936ZM3.42251 5.87041L5.43935 3.85356L3.17678 3.53034L1.80638 4.90074L3.42251 5.87041ZM2.35356 10.3535C2.54882 10.1583 2.54882 9.8417 2.35356 9.64644C2.1583 9.45118 1.84171 9.45118 1.64645 9.64644L0.646451 10.6464C0.451188 10.8417 0.451188 11.1583 0.646451 11.3535C0.841713 11.5488 1.1583 11.5488 1.35356 11.3535L2.35356 10.3535ZM3.85358 11.8536C4.04884 11.6583 4.04885 11.3417 3.85359 11.1465C3.65833 10.9512 3.34175 10.9512 3.14648 11.1465L1.14645 13.1464C0.95119 13.3417 0.951187 13.6583 1.14645 13.8535C1.34171 14.0488 1.65829 14.0488 1.85355 13.8536L3.85358 11.8536ZM5.35356 13.3535C5.54882 13.1583 5.54882 12.8417 5.35356 12.6464C5.1583 12.4512 4.84171 12.4512 4.64645 12.6464L3.64645 13.6464C3.45119 13.8417 3.45119 14.1583 3.64645 14.3535C3.84171 14.5488 4.1583 14.5488 4.35356 14.3535L5.35356 13.3535ZM9.49997 6.74881C10.1897 6.74881 10.7488 6.1897 10.7488 5.5C10.7488 4.8103 10.1897 4.25118 9.49997 4.25118C8.81026 4.25118 8.25115 4.8103 8.25115 5.5C8.25115 6.1897 8.81026 6.74881 9.49997 6.74881Z" fill="currentColor" fill-rule="evenodd" clip-rule="evenodd"></path></svg>'
}

// Higher level collection of nav groupings. A collection is a direct link when
// it points at a single `doc` or an explicit `href`, otherwise it groups `docs`.
type Collection = {
  label: string;
  icon: string;
  docs?: string[];
  doc?: string;
  href?: string;
}

const collections: Collection[] = [
  { label: 'Getting Started', icon: icons.rocket, doc: 'getting-started' },
  { label: 'Users', icon: icons.user, docs: ['core-concepts', 'users'] },
  { label: 'Maintainers', icon: icons.maintainer, docs: ['managing-an-instance', 'hardware-requirements', 'secrets-and-ssh', 'deployment', 'configuration', 'monitoring-and-security'] },
  { label: 'API Reference', icon: icons.api, href: `${base}api` },
]

const isCurrent = (href: string) => currentPath === href.replace(/\/$/, '').split('#')[0]
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} - HWaaS Docs</title>
  </head>

  <body class="bg-(--app-background) text-(--app-primary-text) h-screen flex flex-col w-full overflow-hidden">
    <header class="px-6 py-3 flex justify-between  items-center border-b border-(--app-border)">
      <img class="w-32 h-auto" src={`${base}hwaas_placeholder_logo.svg`}>
      <a href="https://www.github.com/secunet-ag/hwaas">
        <img class="w-8" src={`${base}github.svg`}>
      </a>
    </header>

    <div class="w-full flex flex-1 min-h-0">
      <div id="sidebar-wrapper" class="relative shrink-0 w-68 overflow-visible transition-[width] duration-300 ease-in-out">
        <aside id="sidebar" class="w-full h-full border-r border-(--app-border) px-6 py-3 overflow-y-auto flex flex-col">
          <!-- Nav Bar -->
          <nav class="flex flex-col gap-1 pt-6 flex-1 sidebar-nav">
            {collections.map(collection => {
              const iconMarkup = (
                <span class="w-4 h-4 shrink-0 flex items-center justify-center" set:html={collection.icon} />
              );

              // Leaf collection: a direct link (e.g. the API reference, or a
              // single-doc section like "Getting Started").
              const leafHref = collection.href ?? (collection.doc ? docsById.get(collection.doc)?.href : undefined);
              if (leafHref) {
                const isActive = isCurrent(leafHref);
                return (
                  <a
                    href={leafHref}
                    class:list={[
                      'flex items-center gap-2 px-3 py-2 rounded-md text-sm font-mono font-medium transition-colors',
                      isActive
                        ? 'text-(--app-primary-text)'
                        : 'text-(--app-secondary-text) hover:text-(--app-primary-text)',
                    ]}
                  >
                    {iconMarkup}
                    {collection.label}
                  </a>
                );
              }

              // Grouped collections, for example "Users", or "Maintainers"
              const items = (collection.docs ?? []).flatMap(id => {
                const item = docsById.get(id);
                return item ? [item] : [];
              });

              const containsActive = items.some(item => isCurrent(item.href));

              return (
                <details open={containsActive} class="group">
                  <summary
                    class:list={[
                      'flex items-center gap-2 px-3 py-2 rounded-md text-sm font-mono font-medium cursor-pointer select-none hover:bg-(--app-border)/20 transition-colors',
                      containsActive
                        ? 'text-(--app-primary-text)'
                        : 'text-(--app-secondary-text) hover:text-(--app-primary-text)',
                    ]}
                  >
                    {iconMarkup}
                    <span class="flex-1">{collection.label}</span>
                    <svg
                      class="w-3 h-3 shrink-0 text-(--app-secondary-text) transition-transform group-open:rotate-90"
                      viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
                    >
                      <path d="M4.5 3L7.5 6L4.5 9" />
                    </svg>
                  </summary>
                  <div class="flex flex-col gap-0.5 ml-4 border-l border-(--app-border)/60 pl-3 my-1">
                    {items.map(item => {
                      const isActive = isCurrent(item.href);
                      return (
                        <>
                          <a
                            href={item.href}
                            class:list={[
                              'px-3 py-1.5 rounded-md text-sm transition-colors',
                              isActive
                                ? 'text-(--app-primary-text) font-medium'
                                : 'text-(--app-secondary-text) hover:text-(--app-primary-text)',
                            ]}
                          >
                            {item.label}
                          </a>
                          { item.children?.length > 0 && (
                            <div class="flex flex-col gap-0.5 ml-3 border-l border-(--app-border)/60 pl-3 my-1">
                              {item.children.map(child => (
                                <a
                                  href={child.href}
                                  data-hash-link
                                  class="px-2 py-1 rounded text-sm text-(--app-secondary-text) hover:text-(--app-primary-text) transition-colors"
                                >
                                  {child.label}
                                </a>
                              ))}
                            </div>
                          )}
                        </>
                      );
                    })}
                  </div>
                </details>
              );
            })}
          </nav>
        </aside>
        <button
          id="sidebar-toggle"
          class="sidebar-toggle-btn absolute rounded bottom-4 -right-3.5 z-20 w-7 h-7 flex items-center justify-center bg-(--app-background) border border-(--app-border) text-(--app-secondary-text) hover:text-(--app-primary-text) transition-colors cursor-pointer"
          aria-label="Toggle sidebar"
        >
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <line x1="3" y1="3.5" x2="11" y2="3.5" />
            <line x1="3" y1="7" x2="11" y2="7" />
            <line x1="3" y1="10.5" x2="11" y2="10.5" />
          </svg>
        </button>
      </div>
      <div class="min-w-0 flex-1 overflow-x-hidden overflow-y-auto">
        <!-- Styled Prose Pages, i.e CMS/Docs content -->
        {prose ? 
        (
          <main class="flex w-full justify-center px-12 py-10">
            <div class="sm:mix-w-lg lg:min-w-2xl max-w-3xl 3xl:max-w-4xl w-full">
              <article class="prose prose-invert prose-zinc max-w-full
                prose-headings:font-semibold
                prose-h1:text-3xl prose-h1:mb-6
                prose-h2:text-2xl prose-h2:mt-10 prose-h2:mb-6
                prose-h3:text-xl prose-h3:mb-4
                prose-h4:text-lg prose-h4:mb-3
                prose-code:text-(--app-success) prose-code:bg-zinc-800 prose-code:px-1.5 prose-code:py-1
                prose-code:border prose-code:border-(--app-border) prose-code:rounded-lg
                prose-pre:bg-zinc-900 prose-pre:border prose-pre:border-zinc-800 prose-pre:rounded-lg
                prose-a:text-(--app-info) prose-a:no-underline
                prose-strong:text-(--app-primary!)">
                <slot />
              </article>
            </div>
          </main>
        )     
        : (
          <main class="flex-1 min-w-0">
            <slot />
          </main>
        )}
      </div>
    </div>

    <script>
      const wrapper = document.getElementById('sidebar-wrapper');
      const toggle = document.getElementById('sidebar-toggle');

      toggle?.addEventListener('click', () => {
        wrapper?.classList.toggle('sidebar-collapsed');
      });

      const activeClass = 'text-(--app-primary-text)';
      const inactiveClass = 'text-(--app-secondary-text)';

      function updateHashHighlight() {
        const currentPath = location.pathname.replace(/\/$/, '');
        const currentHash = location.hash;

        document.querySelectorAll<HTMLAnchorElement>('[data-hash-link]').forEach(link => {
          const url = new URL(link.href);
          const linkPath = url.pathname.replace(/\/$/, '');
          const linkHash = url.hash;
          const isActive = currentPath === linkPath && currentHash === linkHash;

          link.classList.toggle(activeClass, isActive);
          link.classList.toggle(inactiveClass, !isActive);
        });
      }

      updateHashHighlight();
      window.addEventListener('hashchange', updateHashHighlight);
    </script>
  </body>
</html>
