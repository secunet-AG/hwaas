---
import '../styles/global.css'
import { render, getCollection } from 'astro:content'

interface Props {
  title: string;
  prose?: boolean;
}

const { title, prose = false } = Astro.props;

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

// Auto-generate doc sidebar items from the content collection
const docs = await getCollection('docs')
const order = ['introduction', 'core-concepts', 'users']
docs.sort((a, b) => {
  const ai = order.indexOf(a.id)
  const bi = order.indexOf(b.id)
  return (ai === -1 ? Infinity : ai) - (bi === -1 ? Infinity : bi)
})

const docItems = await Promise.all(docs.map(async (d) => {
  const { headings } = await render(d)
  const label = headings.find(h => h.depth === 1)?.text ?? d.id
  const children = headings.filter(h => h.depth === 2).map(h => ({
    href: `/docs/${d.id}#${h.slug}`,
    label: h.text,
  }))
  return { href: `/docs/${d.id}`, label, children }
}))

const navItems = [
  { href: '/', label: 'Home', children: [] as { href: string; label: string }[] },
  ...docItems,
  { href: '/api', label: 'API Reference', children: [] as { href: string; label: string }[] },
]
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} - HWaaS Docs</title>
  </head>
  <body class="bg-zinc-950 text-zinc-200 min-h-screen flex w-full">
    <aside class="w-64 shrink-0 border-r border-zinc-800 bg-zinc-900 p-6 sticky top-0 h-screen overflow-y-auto">
      <a href="/" class="block text-lg font-bold text-white mb-8">HWaaS Docs</a>
      <nav class="flex flex-col gap-0.5">
        {navItems.map(item => {
          const itemPath = item.href.replace(/\/$/, '').split('#')[0];
          const isActive = currentPath === itemPath;
          return (
            <>
              <a
                href={item.href}
                class:list={[
                  'px-3 py-2 rounded-md text-sm transition-colors',
                  isActive
                    ? 'bg-zinc-800 text-white font-medium'
                    : 'text-zinc-400 hover:text-zinc-200 hover:bg-zinc-800/50',
                ]}
              >
                {item.label}
              </a>
              {isActive && item.children?.length > 0 && (
                <div class="flex flex-col gap-0.5 ml-3 border-l border-zinc-800 pl-3 my-1">
                  {item.children.map(child => (
                    <a
                      href={child.href}
                      class="px-2 py-1 rounded text-sm text-zinc-500 hover:text-zinc-300 transition-colors"
                    >
                      {child.label}
                    </a>
                  ))}
                </div>
              )}
            </>
          );
        })}
      </nav>
    </aside>
    {prose ? (
      <main class="flex w-full justify-center px-12 py-10">
        <div class="sm:mix-w-lg lg:min-w-2xl max-w-3xl">
          <article class="prose prose-invert prose-zinc max-w-none
            prose-headings:font-semibold
            prose-h1:text-3xl prose-h1:mb-6
            prose-h2:text-xl prose-h2:mt-10 prose-h2:mb-4
            prose-h3:text-lg
            prose-code:text-pink-400 prose-code:bg-zinc-800 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded
            prose-pre:bg-zinc-900 prose-pre:border prose-pre:border-zinc-800 prose-pre:rounded-lg
            prose-a:text-blue-400 prose-a:no-underline hover:prose-a:underline
            prose-strong:text-zinc-100">
            <slot />
          </article>
        </div>
      </main>
    ) : (
      <main class="flex-1 min-w-0">
        <slot />
      </main>
    )}
  </body>
</html>
