---
import '../styles/global.css'

interface Props {
  title: string;
  prose?: boolean;
}

const { title, prose = false } = Astro.props;

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/docs/getting-started', label: 'Getting Started' },
  { href: '/docs/authentication', label: 'Authentication' },
  { href: '/docs/devices', label: 'Devices' },
  { href: '/api', label: 'API Reference' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} - HWaaS Docs</title>
  </head>
  <body class="bg-zinc-950 text-zinc-200 min-h-screen flex">
    <aside class="w-64 shrink-0 border-r border-zinc-800 bg-zinc-900 p-6 sticky top-0 h-screen overflow-y-auto">
      <a href="/" class="block text-lg font-bold text-white mb-8">HWaaS Docs</a>
      <nav class="flex flex-col gap-1">
        {navItems.map(item => (
          <a
            href={item.href}
            class:list={[
              'px-3 py-2 rounded-md text-sm transition-colors',
              currentPath === item.href.replace(/\/$/, '')
                ? 'bg-zinc-800 text-white font-medium'
                : 'text-zinc-400 hover:text-zinc-200 hover:bg-zinc-800/50',
            ]}
          >
            {item.label}
          </a>
        ))}
      </nav>
    </aside>
    {prose ? (
      <main class="flex-1 min-w-0 max-w-3xl px-12 py-10">
        <article class="prose prose-invert prose-zinc max-w-none
          prose-headings:font-semibold
          prose-h1:text-3xl prose-h1:mb-6
          prose-h2:text-xl prose-h2:mt-10 prose-h2:mb-4
          prose-h3:text-lg
          prose-code:text-pink-400 prose-code:bg-zinc-800 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded
          prose-pre:bg-zinc-900 prose-pre:border prose-pre:border-zinc-800 prose-pre:rounded-lg
          prose-a:text-blue-400 prose-a:no-underline hover:prose-a:underline
          prose-strong:text-zinc-100">
          <slot />
        </article>
      </main>
    ) : (
      <main class="flex-1 min-w-0">
        <slot />
      </main>
    )}
  </body>
</html>
