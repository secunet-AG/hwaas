---
interface Props {
  type?: 'important' | 'warning' | 'danger' | 'note';
}

const { type = 'important' } = Astro.props;

const config = {
  important: {
    border: 'border-(--app-success)/40',
    bg: 'bg-(--app-success)/10',
    color: 'text-(--app-success)',
    label: 'Important',
    // lucide:info
    icon: '<circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/>',
  },
  warning: {
    border: 'border-(--app-warning)/40',
    bg: 'bg-(--app-warning)/10',
    color: 'text-(--app-warning)',
    label: 'Warning',
    // lucide:triangle-alert
    icon: '<path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"/><path d="M12 9v4"/><path d="M12 17h.01"/>',
  },
  danger: {
    border: 'border-(--app-danger)/40',
    bg: 'bg-(--app-danger)/10',
    color: 'text-(--app-danger)',
    label: 'Danger',
    // lucide:octagon-x
    icon: '<path d="M2.586 16.726A2 2 0 0 1 2 15.312V8.688a2 2 0 0 1 .586-1.414l4.688-4.688A2 2 0 0 1 8.688 2h6.624a2 2 0 0 1 1.414.586l4.688 4.688A2 2 0 0 1 22 8.688v6.624a2 2 0 0 1-.586 1.414l-4.688 4.688a2 2 0 0 1-1.414.586H8.688a2 2 0 0 1-1.414-.586z"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/>',
  },
  note: {
    border: 'border-(--app-info)/40',
    bg: 'bg-(--app-info)/10',
    color: 'text-(--app-info)',
    label: 'Note',
    // lucide:lightbulb
    icon: '<path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"/><path d="M9 18h6"/><path d="M10 22h4"/>',
  },
};

const s = config[type];
---

<div class={`not-prose my-6 rounded-lg border-2 ${s.border} ${s.bg} px-5 py-4`}>
  <div class={`mb-2 flex items-center gap-2 ${s.color}`}>
    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={s.icon} />
    <span class="text font-mono uppercase tracking-wide font-semibold">{s.label}</span>
  </div>
  <div class="text text-(--app-primary) leading-relaxed [&>p]:m-0">
    <slot />
  </div>
</div>
