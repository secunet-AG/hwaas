{
  "components": {
    "schemas": {
      "KeyboardReport": {
        "description": "User input for keyboard as a list of Keys. A maximum of 6 keys can be pressed at the same time. The modifier is used for keys like \"shift\" and does not count to the limit. All keys can be pressed and/or released, but one must be given. A short description of report format can be found here: https://wiki.osdev.org/USB_Human_Interface_Devices#usb_keyboard.",
        "properties": {
          "keys": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "modifier": {
            "format": "uint8",
            "minimum": 0.0,
            "type": "integer"
          },
          "press": {
            "default": true,
            "type": "boolean"
          },
          "release": {
            "default": true,
            "type": "boolean"
          }
        },
        "required": [
          "keys",
          "modifier"
        ],
        "type": "object"
      },
      "KeyboardText": {
        "description": "User input for keyboard as String. If newline is set to True, '\\n' is appended to the String.",
        "properties": {
          "input": {
            "type": "string"
          },
          "newline": {
            "default": true,
            "type": "boolean"
          }
        },
        "required": [
          "input"
        ],
        "type": "object"
      },
      "MouseReport": {
        "description": "User input for mouse.",
        "properties": {
          "buttons": {
            "description": "Buttons to be pressed. Supported are a maximum of 3: 0 - right, 1 - left, 2 - middle.",
            "items": {
              "format": "uint8",
              "minimum": 0.0,
              "type": "integer"
            },
            "type": "array"
          },
          "wheel": {
            "description": "Coordinate to set the mouse wheel to",
            "format": "int8",
            "type": "integer"
          },
          "x": {
            "description": "Absolute coordinates to move the pointer to",
            "format": "int16",
            "type": "integer"
          },
          "y": {
            "format": "int16",
            "type": "integer"
          }
        },
        "required": [
          "buttons",
          "wheel",
          "x",
          "y"
        ],
        "type": "object"
      },
      "SerialID": {
        "description": "The ID in the API to specify the name of the serial interface to use.",
        "properties": {
          "serial_interface": {
            "description": "Name of the serial interface.",
            "type": "string"
          }
        },
        "required": [
          "serial_interface"
        ],
        "type": "object"
      },
      "StorageLunConfig": {
        "description": "Config for one LUN",
        "properties": {
          "cdrom": {
            "default": false,
            "description": "Emulate a CD-ROM drive?",
            "type": "boolean"
          },
          "path": {
            "description": "Image path",
            "type": "string"
          },
          "read_only": {
            "default": true,
            "description": "Read-only?",
            "type": "boolean"
          }
        },
        "required": [
          "path"
        ],
        "type": "object"
      },
      "UsbFunctionConfig": {
        "description": "Configuration in request\n\nThe order of functions is always determined by this given top-to-bottom discriminant order.",
        "oneOf": [
          {
            "properties": {
              "luns": {
                "items": {
                  "$ref": "#/components/schemas/StorageLunConfig"
                },
                "type": "array"
              },
              "type": {
                "enum": [
                  "storage"
                ],
                "type": "string"
              }
            },
            "required": [
              "luns",
              "type"
            ],
            "type": "object"
          },
          {
            "properties": {
              "type": {
                "enum": [
                  "keyboard"
                ],
                "type": "string"
              }
            },
            "required": [
              "type"
            ],
            "type": "object"
          },
          {
            "properties": {
              "type": {
                "enum": [
                  "mouse"
                ],
                "type": "string"
              }
            },
            "required": [
              "type"
            ],
            "type": "object"
          }
        ]
      },
      "UsbFunctionInfo": {
        "description": "User-facing meta information after configuration",
        "oneOf": [
          {
            "properties": {
              "type": {
                "enum": [
                  "keyboard"
                ],
                "type": "string"
              }
            },
            "required": [
              "type"
            ],
            "type": "object"
          },
          {
            "properties": {
              "type": {
                "enum": [
                  "mouse"
                ],
                "type": "string"
              }
            },
            "required": [
              "type"
            ],
            "type": "object"
          },
          {
            "properties": {
              "luns": {
                "items": {
                  "$ref": "#/components/schemas/StorageLunConfig"
                },
                "type": "array"
              },
              "type": {
                "enum": [
                  "storage"
                ],
                "type": "string"
              }
            },
            "required": [
              "luns",
              "type"
            ],
            "type": "object"
          }
        ]
      }
    }
  },
  "info": {
    "description": "remote-hands usb service",
    "title": "",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/serial": {
      "get": {
        "description": "Query for the ids of all configured serial interfaces",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              }
            },
            "description": "list of all serial interfaces"
          }
        },
        "summary": "Query serial interfaces",
        "tags": [
          "Serial API"
        ]
      }
    },
    "/serial/reset": {
      "post": {
        "description": "Reset all serial interfaces",
        "responses": {
          "204": {
            "description": "no content"
          }
        },
        "summary": "Reset all serial interfaces",
        "tags": [
          "Serial API"
        ]
      }
    },
    "/serial/{serial_interface}": {
      "delete": {
        "description": "Clear the serial buffer",
        "parameters": [
          {
            "description": "Name of the serial interface.",
            "in": "path",
            "name": "serial_interface",
            "required": true,
            "schema": {
              "description": "Name of the serial interface.",
              "type": "string"
            },
            "style": "simple"
          }
        ],
        "responses": {
          "204": {
            "description": "no content"
          }
        },
        "summary": "Clear serial buffer",
        "tags": [
          "Serial API"
        ]
      },
      "get": {
        "description": "Obtain the serial buffer",
        "parameters": [
          {
            "description": "Name of the serial interface.",
            "in": "path",
            "name": "serial_interface",
            "required": true,
            "schema": {
              "description": "Name of the serial interface.",
              "type": "string"
            },
            "style": "simple"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/octet-stream": {}
            },
            "description": "Bytes red from serial buffer"
          }
        },
        "summary": "Read from serial buffer",
        "tags": [
          "Serial API"
        ]
      },
      "post": {
        "description": "Write to serial buffer",
        "parameters": [
          {
            "description": "Name of the serial interface.",
            "in": "path",
            "name": "serial_interface",
            "required": true,
            "schema": {
              "description": "Name of the serial interface.",
              "type": "string"
            },
            "style": "simple"
          }
        ],
        "requestBody": {
          "content": {
            "application/octet-stream": {}
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "no content"
          },
          "503": {
            "description": "Internal error"
          }
        },
        "summary": "Write to serial buffer",
        "tags": [
          "Serial API"
        ]
      },
      "put": {
        "description": "Write to serial buffer",
        "parameters": [
          {
            "description": "Name of the serial interface.",
            "in": "path",
            "name": "serial_interface",
            "required": true,
            "schema": {
              "description": "Name of the serial interface.",
              "type": "string"
            },
            "style": "simple"
          }
        ],
        "requestBody": {
          "content": {
            "application/octet-stream": {}
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "no content"
          },
          "503": {
            "description": "Internal error"
          }
        },
        "summary": "Write to serial buffer",
        "tags": [
          "Serial API"
        ]
      }
    },
    "/serial/{serial_interface}/websocket": {
      "get": {
        "description": "Establish a WebSocket connection with the serial peripheral",
        "parameters": [
          {
            "description": "Name of the serial interface.",
            "in": "path",
            "name": "serial_interface",
            "required": true,
            "schema": {
              "description": "Name of the serial interface.",
              "type": "string"
            },
            "style": "simple"
          }
        ],
        "responses": {
          "101": {
            "description": "websocket upgrade",
            "headers": {
              "connection": {
                "schema": {
                  "const": "upgrade",
                  "enum": [
                    "upgrade"
                  ],
                  "example": "upgrade",
                  "type": "string"
                },
                "style": "simple"
              },
              "sec-websocket-key": {
                "schema": {
                  "type": "string"
                },
                "style": "simple"
              },
              "sec-websocket-protocol": {
                "schema": {
                  "type": "string"
                },
                "style": "simple"
              },
              "upgrade": {
                "schema": {
                  "const": "websocket",
                  "enum": [
                    "websocket"
                  ],
                  "example": "websocket",
                  "type": "string"
                },
                "style": "simple"
              }
            }
          }
        },
        "summary": "Connect to serial via WebSocket",
        "tags": [
          "Serial API"
        ]
      }
    },
    "/usb": {
      "delete": {
        "description": "Deactivate the configured USB functions.",
        "responses": {
          "200": {
            "description": "no content"
          },
          "500": {
            "content": {
              "text/plain; charset=utf-8": {}
            },
            "description": "Could not deconfigure USB functions"
          }
        },
        "summary": "Deconfigure USB interface",
        "tags": [
          "USB API"
        ]
      },
      "get": {
        "description": "Query the currently setup USB functions",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/UsbFunctionInfo"
                  },
                  "type": "array"
                }
              }
            },
            "description": ""
          },
          "500": {
            "content": {
              "text/plain; charset=utf-8": {}
            },
            "description": "Could not read internal USB functions state"
          }
        },
        "summary": "Query USB interface",
        "tags": [
          "USB API"
        ]
      },
      "put": {
        "description": "Configure USB functions and activates them. Returns the currently setup USB functions.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "items": {
                  "$ref": "#/components/schemas/UsbFunctionConfig"
                },
                "type": "array"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/UsbFunctionInfo"
                  },
                  "type": "array"
                }
              }
            },
            "description": ""
          },
          "400": {
            "content": {
              "text/plain; charset=utf-8": {}
            },
            "description": "Bad Request"
          },
          "500": {
            "content": {
              "text/plain; charset=utf-8": {}
            },
            "description": "Could not read internal USB functions state or configure empty list"
          }
        },
        "summary": "Setup USB interface",
        "tags": [
          "USB API"
        ]
      }
    },
    "/usb/keyboard/report": {
      "post": {
        "description": "Use USB OTG keyboard by sending report input - list of keys, modifier, press and release values.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/KeyboardReport"
              }
            }
          },
          "description": "User input for keyboard as a list of Keys. A maximum of 6 keys can be pressed at the same time. The modifier is used for keys like \"shift\" and does not count to the limit. All keys can be pressed and/or released, but one must be given. A short description of report format can be found here: https://wiki.osdev.org/USB_Human_Interface_Devices#usb_keyboard.",
          "required": true
        },
        "responses": {
          "200": {
            "description": "no content"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Unknown input"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Error writing to the keyboard"
          }
        },
        "summary": "Use keyboard with report format",
        "tags": [
          "USB API"
        ]
      }
    },
    "/usb/keyboard/text": {
      "post": {
        "description": "Use USB OTG keyboard by sending plain text input. Each character is send individually. An optional newline can be send afterwards.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/KeyboardText"
              }
            }
          },
          "description": "User input for keyboard as String. If newline is set to True, '\\n' is appended to the String.",
          "required": true
        },
        "responses": {
          "200": {
            "description": "no content"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Unknown input"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Error writing to the keyboard"
          }
        },
        "summary": "Use keyboard with plain text",
        "tags": [
          "USB API"
        ]
      }
    },
    "/usb/mouse": {
      "post": {
        "description": "Use USB OTG mouse by sending button, pointer (x, y) and wheel parameters.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MouseReport"
              }
            }
          },
          "description": "User input for mouse.",
          "required": true
        },
        "responses": {
          "200": {
            "description": "no content"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Unknown input"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Error writing to the mouse"
          }
        },
        "summary": "Use mouse",
        "tags": [
          "USB API"
        ]
      }
    },
    "/usb/reset": {
      "post": {
        "description": "Reset the USB interface",
        "responses": {
          "200": {
            "description": "no content"
          },
          "500": {
            "content": {
              "text/plain; charset=utf-8": {}
            },
            "description": "Could not deconfigure USB functions"
          }
        },
        "summary": "Reset USB interface",
        "tags": [
          "USB API"
        ]
      }
    }
  }
}
