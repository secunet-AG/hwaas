{
  "components": {
    "schemas": {
      "AuxiliaryDevice": {
        "description": "User-facing meta information to return as responses for requests",
        "properties": {
          "activation": {
            "type": "boolean"
          },
          "id": {
            "type": "string"
          }
        },
        "required": [
          "activation",
          "id"
        ],
        "type": "object"
      },
      "AuxiliaryDevicePath": {
        "description": "Path segment labels will be matched with struct field name",
        "properties": {
          "path_suffix": {
            "description": "The part of the URI that will be appended",
            "type": "string"
          }
        },
        "required": [
          "path_suffix"
        ],
        "type": "object"
      },
      "AuxiliaryID": {
        "description": "The ID in the API to specify the name of the auxiliary device to use.",
        "properties": {
          "device_id": {
            "description": "Name of the auxiliary device.",
            "type": "string"
          }
        },
        "required": [
          "device_id"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "remote-hands auxiliary device service",
    "license": {
      "identifier": "Apache-2.0",
      "name": "Apache-2.0"
    },
    "title": "",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/auxiliaries": {
      "get": {
        "description": "Query for information of all connected auxiliary devices",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": [
                  {
                    "activation": true,
                    "id": "example-device"
                  },
                  {
                    "activation": false,
                    "id": "example-device-2"
                  }
                ],
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/AuxiliaryDevice"
                  },
                  "type": "array"
                }
              }
            },
            "description": "JSON representing auxiliary device information for all configured devices."
          },
          "500": {
            "content": {
              "text/plain; charset=utf-8": {}
            },
            "description": "Auxiliary device state error"
          }
        },
        "summary": "Query all auxiliary devices",
        "tags": [
          "Auxiliary Device API"
        ]
      }
    },
    "/auxiliaries/reset": {
      "post": {
        "description": "Reset all auxiliary devices",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/AuxiliaryDevice"
                  },
                  "type": "array"
                }
              }
            },
            "description": ""
          },
          "500": {
            "content": {
              "text/plain; charset=utf-8": {}
            },
            "description": "Auxiliary device state or script error"
          }
        },
        "summary": "Reset all auxiliary devices",
        "tags": [
          "Auxiliary Device API"
        ]
      }
    },
    "/auxiliaries/{device_id}": {
      "get": {
        "description": "Query for auxiliary device information.",
        "parameters": [
          {
            "description": "Name of the auxiliary device.",
            "in": "path",
            "name": "device_id",
            "required": true,
            "schema": {
              "description": "Name of the auxiliary device.",
              "type": "string"
            },
            "style": "simple"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "activation": true,
                  "id": "example-device"
                },
                "schema": {
                  "$ref": "#/components/schemas/AuxiliaryDevice"
                }
              }
            },
            "description": "JSON representing auxiliary device information for given device ID."
          },
          "404": {
            "content": {
              "text/plain; charset=utf-8": {}
            },
            "description": "Auxiliary Device ID is unknown."
          }
        },
        "summary": "Query information",
        "tags": [
          "Auxiliary Device API"
        ]
      }
    },
    "/auxiliaries/{device_id}/activation": {
      "get": {
        "description": "Query for auxiliary device activation status.",
        "parameters": [
          {
            "description": "Name of the auxiliary device.",
            "in": "path",
            "name": "device_id",
            "required": true,
            "schema": {
              "description": "Name of the auxiliary device.",
              "type": "string"
            },
            "style": "simple"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "boolean"
                }
              }
            },
            "description": "Boolean representing auxiliary device activation information for given device ID."
          },
          "404": {
            "content": {
              "text/plain; charset=utf-8": {}
            },
            "description": "Auxiliary Device ID is unknown."
          }
        },
        "summary": "Query activation status",
        "tags": [
          "Auxiliary Device API"
        ]
      },
      "put": {
        "description": "Set the activation state to the specified value. 'true' activates the device.",
        "parameters": [
          {
            "description": "Name of the auxiliary device.",
            "in": "path",
            "name": "device_id",
            "required": true,
            "schema": {
              "description": "Name of the auxiliary device.",
              "type": "string"
            },
            "style": "simple"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "boolean"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "no content"
          },
          "400": {
            "content": {
              "text/plain; charset=utf-8": {}
            },
            "description": "Invalid body."
          },
          "404": {
            "content": {
              "text/plain; charset=utf-8": {}
            },
            "description": "Auxiliary Device ID is unknown."
          },
          "500": {
            "content": {
              "text/plain; charset=utf-8": {}
            },
            "description": "Auxiliary Device activation command failed."
          }
        },
        "summary": "Set the activation state",
        "tags": [
          "Auxiliary Device API"
        ]
      }
    },
    "/auxiliaries/{device_id}/api": {
      "delete": {
        "description": "Any requests send to this endpoint will be reverse proxied to the auxiliary device. Refer to the API documentation of the specific auxiliary device for more information.",
        "parameters": [
